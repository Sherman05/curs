# Скопируйте этот файл в .env и заполните своими значениями.
# .env НЕ коммитится в репозиторий (см. .gitignore).

# Секретный ключ Flask (сгенерируйте случайную строку).
SECRET_KEY=change-me-to-random-string

# Конфигурация: development / production / testing
FLASK_CONFIG=development

# Ключ Anthropic Claude API (для AI-модуля).
# Без ключа AI-модуль работает в demo-режиме (заглушки).
ANTHROPIC_API_KEY=

# Модели Claude (можно не менять).
AI_MODEL=claude-sonnet-4-5
AI_MODEL_FAST=claude-haiku-4-5

# Порог "группы риска" по среднему баллу.
RISK_THRESHOLD=3.5
